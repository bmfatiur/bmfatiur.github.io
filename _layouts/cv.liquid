---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="embed-responsive embed-responsive-4by3 mt-4">
      <iframe
        class="embed-responsive-item"
        src="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
        width="80%"
        height="600px"
        style="border: none;"
        allowfullscreen
      >
        This browser does not support PDFs. Please download the PDF to view it:
        <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}">Download PDF</a>.
      </iframe>
    </div>
  </article>
</div>
